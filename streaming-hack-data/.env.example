# Read automatically by `docker compose` (same folder as docker-compose.yml).

# Images
KAFKA_IMAGE=apache/kafka:3.8.0
HADOOP_VERSION_TAG=2.0.0-hadoop3.2.1-java8
SPARK_IMAGE=apache/spark:3.5.1-python3

# Kafka
KAFKA_TOPIC=hack-attacks
KAFKA_EXTERNAL_PORT=29092
KAFKA_PARTITIONS=3

# Ports on your machine
HDFS_UI_PORT=9870
SPARK_UI_PORT=4040

# MLflow and its stores
MINIO_IMAGE=cgr.dev/chainguard/minio:latest
MINIO_USER=minioadmin
MINIO_PASSWORD=change-me
MLFLOW_DB_USER=mlflow
MLFLOW_DB_PASSWORD=change-me

# Airflow
AIRFLOW_DB_PASSWORD=change-me
# Same password URL-encoded (e.g. @ -> %40), used in the connection string
AIRFLOW_DB_PASSWORD_URL=change-me
AIRFLOW_JWT_SECRET=change-me
